.venv/
__pycache__/
*.pyc
.pytest_cache/

# Data: nothing under data/ is committed (real, public, split or synthetic files).
# Synthetic samples are regenerated by scripts/make_synthetic_lab_reports.py.
# See docs/DATA_GOVERNANCE.md §4. Only a README explaining the folder is allowed.
data/*
!data/README.md

# Medical image formats
*.dcm
*.nii
*.nii.gz

# Model weights and checkpoints
models/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.h5

# Secrets and logs
.env
.env.*
*.key
*.pem
*.log
logs/

# Signed proposal/TAF documents stay local (they contain signatures and personal details)
/*.pdf
